{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "../env/**/*.env",
        "outDir": "dist/env"
      },
      {
        "include": "templates/**/*",
        "outDir": "dist"
      },
      {
        "include": "database/config/*.js",
        "outDir": "dist"
      },
      {
        "include": "database/migrations/**/*.js",
        "outDir": "dist"
      },
      {
        "include": "../.sequelizerc",
        "outDir": "dist/.sequelizerc"
      }
    ]
  }
}
