# Server setting
PORT=7001

# Database settings
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=flexiwork
DB_PASSWORD=flexiwork
DB_NAME=flexiwork_sn_dev
DB_ENCRYPT=false

# JWT settings
JWT_SECRET_KEY=
ADMIN_TOKEN_EXPIRES_IN=28800000
EMPLOYEE_TOKEN_EXPIRES_IN=43200000

# Front-end setting
FRONTEND_URL=http://localhost:8080

# Mailgun credentials
MAILGUN_BASE_URL=https://api.eu.mailgun.net
MAILGUN_PRIVATE_KEY=
MAILGUN_DOMAIN=flexiwork.local
MAILGUN_SENDER=noreply@flexiwork.local

# Logging settings
LOGGING_LEVEL=debug
LOGGING_DAYS=15
LOGGING_FOLDER_PATH=./logs

# Uploads folder path 
UPLOADS_API_PATH=api/uploads
UPLOAD_PATH=./uploads

# ---------------------------------------------------------------------------
# Flexiwork Configuration
# ---------------------------------------------------------------------------
FEATURE_SHIFT_NETWORK=true
SN_LEGACY_ISOLATION=true
# memory | kafka
MESSAGE_BUS_DRIVER=memory
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=flexiwork
KAFKA_TOPIC_PARTITIONS=3
OUTBOX_POLL_MS=200
OUTBOX_BATCH_SIZE=200
# empty = in-memory locks/idempotency/timers (single process, dev/tests only)
REDIS_URL=redis://localhost:6379
# memory | redis
CACHE_DRIVER=memory
# postgres | elasticsearch
SEARCH_DRIVER=postgres
ES_NODE=http://localhost:9200
ES_INDEX_PREFIX=sn
SN_TIME_ZONE=Asia/Ho_Chi_Minh
# development only: divides every timer duration
SN_TIMER_SPEEDUP=1
# Multiplies the per-IP limits on SN auth/webhook routes (dev/E2E run many logins from one IP)
SN_RATE_LIMIT_FACTOR=1
# Worker/background metrics log line interval
SN_METRICS_INTERVAL_SEC=60
SN_OFFER_TTL_MIN=15
SN_SHIFT_MIN_LEAD_MIN=60
SN_ESCROW_DEADLINE_MIN=30
SN_NO_SHOW_GRACE_MIN=15
SN_CHECKIN_EARLY_MIN=30
SN_AUTO_CHECKOUT_AFTER_END_MIN=120
SN_AUTO_CONFIRM_HOURS=12
SN_RATING_WINDOW_HOURS=72
SN_FREE_CANCEL_HOURS=12
SN_LATE_CANCEL_COMP_PCT=30
SN_PLATFORM_FEE_PCT=10
SN_PIT_RATE_PCT=10
SN_PIT_THRESHOLD_VND=2000000
SN_AUTO_PAYOUT_MAX_VND=5000000
SN_GEOFENCE_DEFAULT_M=150
SN_GPS_MAX_ACCURACY_M=100
QR_TOKEN_SECRET=
# fake (only adapter in v1)
PAYMENT_GATEWAY=fake
FAKE_GATEWAY_WEBHOOK_SECRET=
FAKE_GATEWAY_DELAY_MS=1500
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
FCM_CREDENTIALS_PATH=
