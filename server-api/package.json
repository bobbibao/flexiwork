{
  "name": "archapp_api",
  "version": "0.1.0",
  "description": "Server API for ArchApp",
  "author": {
    "name": "Consortia Group",
    "url": "https://consortiagroup.co/"
  },
  "private": true,
  "resolutions": {
    "canvas": "3.1.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start-dev": "cross-env ENV_PATH=/Users/baohoang/Desktop/115/server-api/env NODE_ENV=development nest start --watch",
    "start-debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start-test": "node ./index.js",
    "start-staging": "cross-env NODE_ENV=staging node ./dist/main.js",
    "start-prod": "cross-env NODE_ENV=production node ./dist/main.js",
    "prettier": "npx prettier --write .",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test-watch": "jest --watch",
    "test-cov": "jest --coverage",
    "test-debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test-e2e": "jest --config ./test/jest-e2e.json",
    "migrate:dev": "cross-env NODE_ENV=development npx sequelize-cli db:migrate --env development",
    "migrate:staging": "cross-env NODE_ENV=staging npx sequelize-cli db:migrate --env staging",
    "migrate:prod": "cross-env NODE_ENV=production npx sequelize-cli db:migrate --env production",
    "rollback:dev": "cross-env NODE_ENV=development npx sequelize-cli db:migrate:undo --env development",
    "rollback:staging": "cross-env NODE_ENV=staging npx sequelize-cli db:migrate:undo --env staging",
    "rollback:prod": "cross-env NODE_ENV=production npx sequelize-cli db:migrate:undo --env production",
    "migrate:generate": "npx sequelize-cli migration:generate",
    "start:sn-dev": "cross-env NODE_ENV=development ENV_PATH=./env/sn nest start --watch",
    "start:sn-worker-dev": "cross-env NODE_ENV=development ENV_PATH=./env/sn nest start --watch --entryFile main.worker",
    "start:sn-worker": "node ./dist/main.worker.js",
    "migrate:sn-dev": "cross-env NODE_ENV=development DOTENV_CONFIG_PATH=env/sn/development.env node -r dotenv/config node_modules/sequelize-cli/lib/sequelize db:migrate --env development",
    "rollback:sn-dev": "cross-env NODE_ENV=development DOTENV_CONFIG_PATH=env/sn/development.env node -r dotenv/config node_modules/sequelize-cli/lib/sequelize db:migrate:undo --env development",
    "seed:sn-dev": "cross-env NODE_ENV=development DOTENV_CONFIG_PATH=env/sn/development.env ts-node -r dotenv/config -r tsconfig-paths/register src/database/seeders/sn-dev.seeder.ts",
    "sn:rebuild-projection": "cross-env NODE_ENV=development DOTENV_CONFIG_PATH=env/sn/development.env ts-node -r dotenv/config -r tsconfig-paths/register src/shared/messaging/rebuild-projection.ts",
    "sn:reindex-search": "cross-env NODE_ENV=development DOTENV_CONFIG_PATH=env/sn/development.env ts-node -r dotenv/config -r tsconfig-paths/register src/shared/search/reindex-search.ts",
    "test:sn": "jest --testPathPattern \"src/(shared|modules/(shift|wallet|matching|rating|notification|ops|sn-auth|worker-profile|employer-profile|shift-network))/\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "dependencies": {
    "@bbitgmbh/bbit.swiss-qr-bill": "^4.1.1",
    "@elastic/elasticsearch": "^8.15.0",
    "@nestjs/cache-manager": "^2.1.1",
    "@nestjs/common": "^10.2.5",
    "@nestjs/config": "^3.0.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/cqrs": "^10.2.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/sequelize": "^10.0.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/websockets": "^10.4.15",
    "@node-rs/bcrypt": "^1.10.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "body-parser": "^1.20.3",
    "bullmq": "^5.21.0",
    "cache-manager": "^5.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "docxtemplater": "^3.54.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "firebase-admin": "^12.7.0",
    "form-data": "^4.0.1",
    "ioredis": "^5.4.1",
    "jsdom": "^25.0.1",
    "kafkajs": "^2.2.4",
    "libphonenumber-js": "^1.11.9",
    "libreoffice-convert": "^1.6.0",
    "lodash": "^4.17.21",
    "mailgun.js": "10.2.1",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "pizzip": "^3.1.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.32.1",
    "sequelize-cli": "^6.6.2",
    "sequelize-typescript": "^2.1.5",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/archiver": "^6.0.2",
    "@types/body-parser": "^1",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/cron": "^2.4.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.14.202",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.3.1",
    "@types/passport": "^0",
    "@types/pg": "^8",
    "@types/supertest": "^2.0.12",
    "@types/validator": "^13.11.7",
    "@types/web-push": "^3.6.4",
    "@types/xmldom": "^0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "html-docx-js-typescript": "^0.1.5",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "npm-build-zip": "^1.0.4",
    "npm-pack-zip": "^1.3.0",
    "prettier": "^3.1.1",
    "pretty-quick": "^3.1.3",
    "sequelize-auto": "^0.8.8",
    "shx": "^0.3.4",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-zip-build": "^1.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "src/(.*)": "<rootDir>/$1"
    },
    "packageManager": "yarn@4.4.1"
  },
  "packageManager": "yarn@4.4.1"
}
